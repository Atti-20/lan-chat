  "messageStates": {
    "sending": {
      "label": "发送中",
      "tone": "color.text.secondary",
      "meaning": "已进入本地发送流程，尚未收到服务端确认。"
    },
    "sent": {
      "label": "已发送",
      "tone": "color.text.secondary",
      "event": "CHAT_ACK",
      "meaning": "服务端已持久化；重复 ACK 只更新原消息。"
    },
    "failed": {
      "label": "发送失败",
      "tone": "color.status.danger",
      "meaning": "失败或确认超时；提供原消息重试。"
    },
    "recalled": {
      "label": "已撤回",
      "tone": "color.text.secondary",
      "event": "CHAT_RECALL",
      "meaning": "展示撤回占位，不再展示原文。"
    },
    "burned": {
      "label": "已焚毁",
      "tone": "color.text.secondary",
      "event": "CHAT_BURN",
      "meaning": "内容已不可展示，不复用普通已发送样式。"
    },
    "waitingNetwork": {
      "label": "等待连接",
      "tone": "color.text.secondary",
      "input": "WAITING_NETWORK",
      "meaning": "稳定投递状态来自上游。"
    },
    "retrying": {
      "label": "发送中",
      "tone": "color.text.secondary",
      "input": "SENDING",
      "meaning": "重试原 clientMsgId 后的显示阶段，不是新增业务枚举。"
    }
  },
  "platforms": {
    "webDesktop": {
      "navigation": "三栏工作区，键盘导航和右键菜单；可见焦点；弹层关闭恢复焦点。",
      "input": "Enter 发送、Shift+Enter 换行，输入法组合中不发送。"
    },
    "mobileFlutter": {
      "navigation": "窄屏单栏、原生返回与底部弹层；安全区和系统键盘共同决定可用高度。",
      "input": "触摸目标至少 44 逻辑像素；发送按钮保持可见；遵守系统文字缩放与减少动态效果。",
      "font": "系统默认字体，不把 -apple-system/BlinkMacSystemFont 当作 Flutter 字体名。"
    },
    "materials": {
      "web": "玻璃、CSS 阴影和渐变为 webOnly token。",
      "flutter": "使用语义面板色、边线与 Material 层次；不得把 CSS 字符串伪装成已转换的原生材质。"
    },
    "policy": "Design consistency != pixel identity; platform-and-theme.md separates current behavior from future requirements."
  },
