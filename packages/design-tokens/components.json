      "title": "消息输入区",
      "tokens": [
        "fill",
        "ink",
        "space-3",
        "control-height",
        "radius-control"
      ],
      "states": [
        "empty",
        "ready",
        "sending",
        "offline",
        "readOnly"
      ],
