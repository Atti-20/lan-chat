{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MeshX",
  "version": "0.3.0",
  "identifier": "com.atti20.lanchat",
  "build": {
    "beforeDevCommand": "npm --prefix ../../frontend run dev:desktop",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm --prefix ../../frontend run build:desktop",
    "frontendDist": "../../../frontend/dist-desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MeshX",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 480,
        "center": true,
        "resizable": true,
        "visible": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "media-src": "'self' blob:",
        "frame-src": "'self' blob:",
        "worker-src": "'self' blob: customprotocol: asset:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      },
      "devCsp": "default-src 'self' customprotocol: asset: http://127.0.0.1:1420; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; media-src 'self' blob:; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; worker-src 'self' blob: customprotocol: asset:"
    }
  },
  "bundle": {
    "active": true,
    "category": "SocialNetworking",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "LAN-first private collaboration client",
    "longDescription": "MeshX provides private messaging and file collaboration for organization-controlled local networks."
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["lanchat"]
      }
    },
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  }
}
