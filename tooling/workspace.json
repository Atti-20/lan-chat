{
  "schemaVersion": 1,
  "modules": [
    {
      "id": "server",
      "path": "services/server",
      "role": "Spring Boot 控制面、业务 API、WebSocket 与 Relay",
      "entries": [
        "pom.xml",
        "src/main/java/com/lanchat/LanChatServerApplication.java",
        "src/main/java/com/lanchat/websocket/ChatWebSocketHandler.java"
      ],
      "extensions": [
        ".java"
      ],
      "relatedDocs": [
        {
          "path": "contracts/README.md",
          "when": "接口与消息变更"
        },
        {
          "path": "docs/generated/api-summary.md",
          "when": "定位 REST 路由"
        },
        {
          "path": "docs/generated/sql-map.md",
          "when": "数据库变更"
        }
      ],
      "verificationScopes": [
        "server",
        "contracts"
      ]
    },
    {
      "id": "web",
      "path": "apps/web",
      "role": "Web / Tauri 共享 Vue 应用；迁移期间仍服务 Capacitor",
      "entries": [
        "src/main.ts",
        "src/App.vue",
        "src/services/api.ts",
        "src/composables/useWebSocket.ts",
        "DESIGN.md"
      ],
      "extensions": [
        ".ts",
        ".vue",
        ".css"
      ],
      "relatedDocs": [
        {
          "path": "docs/design/README.md",
          "when": "界面规则"
        },
        {
          "path": "contracts/README.md",
          "when": "API 或消息变更"
        },
        {
          "path": "docs/architecture/platform-adapters.md",
          "when": "平台能力"
        }
      ],
      "verificationScopes": [
        "core",
        "web"
      ]
    },
    {
      "id": "desktop",
      "path": "apps/desktop",
      "role": "Tauri 原生适配与桌面打包",
      "entries": [
        "src-tauri/src/lib.rs",
        "src-tauri/tauri.conf.json"
      ],
      "extensions": [
        ".rs"
      ],
      "relatedDocs": [
        {
          "path": "docs/architecture/platform-adapters.md",
          "when": "桥接与原生能力"
        },
        {
          "path": "docs/design/README.md",
          "when": "窗口或界面变更"
        }
      ],
      "verificationScopes": [
        "desktop"
      ]
    },
    {
      "id": "android",
      "path": "apps/android",
      "role": "迁移期间保留的 Capacitor Android 客户端",
      "entries": [
        "app/src/main/java/com/meshx/android/MainActivity.java",
        "app/build.gradle.kts",
        "scripts/sync-web.mjs"
      ],
      "extensions": [
        ".java",
        ".kts"
      ],
      "relatedDocs": [
        {
          "path": "docs/adr/0004-client-target-and-contracts.md",
          "when": "区分现有壳与 Flutter 目标"
        },
        {
          "path": "docs/architecture/platform-adapters.md",
          "when": "原生能力"
        }
      ],
      "verificationScopes": [
        "android"
      ]
    },
    {
      "id": "ios",
      "path": "apps/ios",
      "role": "迁移期间保留的 Capacitor iOS 客户端",
      "entries": [
        "ios/App/App/AppDelegate.swift",
        "ios/App/App/MeshXViewController.swift",
        "capacitor.config.json"
      ],
      "extensions": [
        ".swift"
      ],
      "relatedDocs": [
        {
          "path": "docs/adr/0004-client-target-and-contracts.md",
          "when": "区分现有壳与 Flutter 目标"
        },
        {
          "path": "docs/architecture/platform-adapters.md",
          "when": "原生能力"
        }
      ],
      "verificationScopes": [
        "ios"
      ]
    },
    {
      "id": "flutter",
      "path": "apps/flutter-prototype",
      "role": "目标移动端路线的 Flutter 切片原型；完整迁移未完成",
      "entries": [
        "README.md",
        "lib/main.dart",
        "lib/chat_controller.dart",
        "lib/application/attachment_controller.dart",
        "lib/data/attachments_models.dart",
        "lib/ui/attachments/attachment_message.dart",
        "lib/platform/discovery.dart"
      ],
      "extensions": [
        ".dart",
        ".kt",
        ".swift"
      ],
      "relatedDocs": [
        {
          "path": "docs/adr/0004-client-target-and-contracts.md",
          "when": "移动端迁移范围"
        },
        {
          "path": "contracts/README.md",
          "when": "API 与消息变更"
        },
        {
          "path": "docs/design/README.md",
          "when": "主题或界面变更"
        }
      ],
      "verificationScopes": [
        "flutter",
        "flutter-candidate",
        "contracts"
      ]
    },
    {
      "id": "protocol",
      "path": "packages/protocol",
      "role": "REST TS / WS TS 和 Dart 的机器契约生成边界",
      "entries": [
        "src/index.ts",
        "src/envelope.ts",
        "src/events.ts",
        "src/rest.ts"
      ],
      "extensions": [
        ".ts"
      ],
      "relatedDocs": [
        {
          "path": "contracts/AGENTS.md",
          "when": "修改协议源或生成器"
        },
        {
          "path": "contracts/README.md",
          "when": "协议字段与兼容性"
        }
      ],
      "verificationScopes": [
        "contracts",
        "web",
        "flutter"
      ]
    },
    {
      "id": "domain",
      "path": "packages/domain-ts",
      "role": "平台无关的聊天模型、消息合并/排序、outbox 恢复、重连与序列规则",
      "entries": [
        "src/models.ts",
        "src/conversation.ts",
        "src/sequence.ts",
        "src/messages.ts",
        "src/outbox.ts",
        "src/realtime.ts"
      ],
      "extensions": [
        ".ts"
      ],
      "relatedDocs": [
        {
          "path": "contracts/websocket/README.md",
          "when": "序列和消息状态"
        },
        {
          "path": "docs/architecture/platform-adapters.md",
          "when": "共享模型的依赖方向"
        }
      ],
      "verificationScopes": [
        "core",
        "contracts",
        "web"
      ]
    },
    {
      "id": "ports",
      "path": "packages/platform-ports",
      "role": "现有宿主接口与小型 Outbox/Realtime Ports；无平台实现",
      "entries": [
        "src/index.ts",
        "src/runtime.ts",
        "src/outbox.ts",
        "src/realtime.ts"
      ],
      "extensions": [
        ".ts"
      ],
      "relatedDocs": [
        {
          "path": "docs/architecture/platform-adapters.md",
          "when": "接口与适配实现"
        }
      ],
      "verificationScopes": [
        "core",
        "contracts",
        "web"
      ]
    },
    {
      "id": "design",
      "path": "packages/design-tokens",
      "role": "中立设计 token 和组件状态，生成 CSS / Dart",
      "entries": [
        "README.md",
        "tokens.json",
        "components.json",
        "tokens.css"
      ],
      "extensions": [
        ".json",
        ".css"
      ],
      "relatedDocs": [
        {
          "path": "docs/design/README.md",
          "when": "设计源及转换规则"
        },
        {
          "path": "docs/design/validation.md",
          "when": "实际渲染验收"
        }
      ],
      "verificationScopes": [
        "design",
        "contracts",
        "core",
        "web",
        "flutter"
      ]
    },
    {
      "id": "website",
      "path": "apps/website",
      "role": "独立静态产品官网，不进入聊天应用构建",
      "entries": [
        "index.html"
      ],
      "extensions": [
        ".html"
      ],
      "relatedDocs": [],
      "verificationScopes": [
        "workspace"
      ]
    },
    {
      "id": "contracts",
      "path": "contracts",
      "role": "REST 与 WS 结构源、兼容规则及测试帧",
      "entries": [
        "README.md",
        "rest/README.md",
        "websocket/README.md"
      ],
      "extensions": [
        ".json"
      ],
      "relatedDocs": [
        {
          "path": "docs/generated/api-summary.md",
          "when": "REST 路由定位"
        },
        {
          "path": "docs/adr/0005-repository-context-and-contract-authority.md",
          "when": "事实来源和变更策略"
        }
      ],
      "verificationScopes": [
        "contracts"
      ]
    },
    {
      "id": "workspace",
      "path": "tooling",
      "role": "按需上下文、生成文档和统一验证工具",
      "entries": [
        "workspace.py",
        "workspace.json",
        "api_summary.py",
        "verification.py"
      ],
      "extensions": [
        ".py",
        ".mjs"
      ],
      "relatedDocs": [
        {
          "path": "docs/ai/INDEX.md",
          "when": "按修改任务定位"
        },
        {
          "path": "docs/architecture/repository-context.md",
          "when": "上下文与指令预算"
        },
        {
          "path": "docs/AGENTS.md",
          "when": "文档变更"
        },
        {
          "path": "docs/runbooks/testing.md",
          "when": "统一验证范围"
        }
      ],
      "verificationScopes": [
        "workspace",
        "tooling"
      ]
    }
  ],
  "verification": {
